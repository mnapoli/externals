includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    level: 7

    paths:
        - app

    ignoreErrors:
        # Used by the Volt components, in Blade files that PHPStan doesn't analyse
        -
            identifier: trait.unused
            path: app/Support/ComputesViewDataOnce.php
